REPORT ZDRILLDOWN.
TABLES CUSTOMERS.

SELECT * FROM CUSTOMERS WHERE CITY <> 'ROMA'.
      WRITE: / CUSTOMERS-NAME, CUSTOMERS-CITY HOTSPOT ON.
ENDSELECT.

AT LINE-SELECTION.
   SELECT * FROM CUSTOMERS WHERE CITY = 'ROMA'.
            WRITE:  CUSTOMERS-NAME.
   ENDSELECT.
SKIP 1.
WRITE: 'THIS CUSTOMERS LIVES IN ROME'.
